# Copia este archivo a .env.local y rellena los valores reales.
# Obtén estas claves en: https://supabase.com/dashboard → tu proyecto → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Clave secreta para autenticar el script Python con la API del dashboard.
# Ponle un string largo y aleatorio (ej: openssl rand -hex 32)
SCANNER_API_KEY=CAMBIA_ESTO_POR_UNA_CLAVE_SEGURA
